<?xml version="1.0" encoding="UTF-8"?>
<!--
  Anexa para o Novo Outlook.
  Antes de instalar, troque https://ENDERECO-DO-ANEXA pelo endereço onde os arquivos
  estão publicados (o CONFIGURAR.bat faz isso por você).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>6f1c3b9e-2a7d-4c5e-9b84-3d0e8a1f52c7</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Anexa</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  <DisplayName DefaultValue="Anexa"/>
  <Description DefaultValue="Anexa automaticamente o arquivo padrão em cada e-mail novo e, se ativado, envia quando houver destinatário válido."/>
  <IconUrl DefaultValue="https://ENDERECO-DO-ANEXA/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://ENDERECO-DO-ANEXA/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://ENDERECO-DO-ANEXA/taskpane.html"/>
  <AppDomains>
    <AppDomain>https://ENDERECO-DO-ANEXA</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://ENDERECO-DO-ANEXA/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.13">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- O Novo Outlook executa os eventos em um runtime de navegador que carrega este HTML. -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="anexaComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="anexaComposeButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="anexaReadGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="anexaReadButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
                <LaunchEvent Type="OnMessageRecipientsChanged" FunctionName="onMessageRecipientsChangedHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://ENDERECO-DO-ANEXA/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://ENDERECO-DO-ANEXA/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://ENDERECO-DO-ANEXA/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://ENDERECO-DO-ANEXA/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://ENDERECO-DO-ANEXA/taskpane.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://ENDERECO-DO-ANEXA/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://ENDERECO-DO-ANEXA/commands.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Anexa"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="Anexa"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Escolha o arquivo padrão e configure o envio automático."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
